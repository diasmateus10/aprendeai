# Chave da API da Anthropic (Claude) para a conversa com IA (fica só no servidor).
# Crie em https://platform.claude.com/settings/keys, copie este arquivo para .env e cole a chave lá.
ANTHROPIC_API_KEY=
# Opcional: modelo usado na conversa (padrão: claude-haiku-5-5, o mais rápido e barato).
# ANTHROPIC_MODEL=claude-opus-5-5

# Voz natural (Azure AI Speech, plano gratuito F0). Sem isso, o app usa as vozes do aparelho.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=

# Lembretes diários por notificação e limites de uso (Supabase). Sem isso, os limites ficam em memória
# e o lembrete fica desligado. Tabelas: supabase/migrations/.
SUPABASE_URL=https://akctjmradduksgxnpian.supabase.co
SUPABASE_SECRET_KEY=
# Gere com: npx web-push generate-vapid-keys (a pública fica em src/data/push.ts)
VAPID_PRIVATE_KEY=
# Senha que a Vercel envia ao chamar a tarefa diária (/api/cron/reminders)
CRON_SECRET=
