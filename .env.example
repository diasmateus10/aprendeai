# Chave da API da Anthropic (Claude) para a conversa com IA (fica só no servidor).
# Crie em https://platform.claude.com/settings/keys, copie este arquivo para .env e cole a chave lá.
ANTHROPIC_API_KEY=
# Opcional: modelo usado na conversa (padrão: claude-haiku-5-5, o mais rápido e barato).
# ANTHROPIC_MODEL=claude-opus-5-5

# Voz natural (Azure AI Speech, plano gratuito F0). Sem isso, o app usa as vozes do aparelho.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=

# Lembretes diários por notificação e limites de uso (Supabase). Sem isso, os limites ficam em memória
# e o lembrete fica desligado. Tabelas: supabase/migrations/.
SUPABASE_URL=https://akctjmradduksgxnpian.supabase.co
SUPABASE_SECRET_KEY=
# Gere com: npx web-push generate-vapid-keys (a pública fica em src/data/push.ts)
VAPID_PRIVATE_KEY=
# Senha para disparar os lembretes à mão (/api/cron/reminders); o agendamento fica no Trigger.dev
CRON_SECRET=

# Assinaturas (Stripe). Depois de pôr a chave, rode: node scripts/stripe-setup.mjs
# (cria produto, preços, portal e webhook, e grava STRIPE_WEBHOOK_SECRET aqui)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Tarefas em segundo plano (Trigger.dev): agente de dificuldades, relatório semanal, lembrete diário e
# aviso de fim do teste grátis. Sem a chave, o agente roda dentro da resposta do chat e o resto fica desligado.
# Publique as tarefas com: npx trigger deploy --env prod
TRIGGER_SECRET_KEY=
TRIGGER_PROJECT_REF=
